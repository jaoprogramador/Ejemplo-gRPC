syntax = "proto3";

option java_multiple_files = true;
option java_package = "com.restaurantes.api.grpc";

service RestauranteService {
    // Definimos el método para obtener un restaurante por ID
    rpc getOneById(id) returns (RestauranteObject) {}
    rpc getAll(Empty) returns (RestauranteList) {}
    //CompletableFuture<Restaurantes> save(Restaurantes restaurante); 
    //CompletableFuture<Restaurantes> getOneById(Long id);
    //CompletableFuture<List<Restaurantes>> getAll();
    //CompletableFuture<Restaurantes> update(Restaurantes restaurante, Long id);
    //CompletableFuture<Restaurantes> delete(Long id);
}

// Mensaje para enviar el ID del restaurante
message id {
    int64 id = 1;
}

// Objeto que representa la entidad Restaurantes en gRPC
message RestauranteObject {
    int64 id = 1;
    string nombre = 2;
    string direccion = 3;
    string especialidad = 4;
    int32 estado = 5;
}

message Empty {
}
message RestauranteList {
	repeated RestauranteObject;
}

    